# ──────────────────────────────────────────────
# 飞书应用配置（必填）
# ──────────────────────────────────────────────

# 飞书应用 App ID（默认已填入）
FEISHU_APP_ID=cli_aa1d00640cf9dcd4

# 飞书应用 App Secret（必填！从飞书开放平台后台获取）
# 路径：开发者后台 → 应用 → 凭证与基础信息 → App Secret
FEISHU_APP_SECRET=your_app_secret_here

# ──────────────────────────────────────────────
# Dify Chat API 配置（必填）
# ──────────────────────────────────────────────

# Dify Chat API 端点（末尾不要带 /chat-messages，代码会自动拼接）
# 示例：
#   云端版：https://api.dify.ai/v1
#   自建版：http://10.232.5.5/v1
DIFY_API_URL=http://10.232.5.5/v1

# Dify 应用 API 密钥（必填！在 Dify 应用 → 访问 API → API 密钥 页获取）
# 格式一般为 app-xxxxxxxxxxxxxxxx
DIFY_API_KEY=your_dify_api_key_here

# ──────────────────────────────────────────────
# 邮件配置（IMAP/SMTP，可选）
# ──────────────────────────────────────────────

# IMAP 服务器（收邮件）
# 网易企业邮（杭州）：imaphz.qiye.163.com
# 腾讯企业邮：imap.exmail.qq.com
IMAP_HOST=imaphz.qiye.163.com
IMAP_PORT=993

# SMTP 服务器（发邮件）
# 网易企业邮（杭州）：smtphz.qiye.163.com
# 腾讯企业邮：smtp.exmail.qq.com
SMTP_HOST=smtphz.qiye.163.com
SMTP_PORT=994

# 邮箱账号
EMAIL_USER=yixing.li@ninebot.com

# 邮箱密码或客户端授权码
EMAIL_PASS=your_email_password_here

# 允许使用邮件功能的飞书用户 open_id（逗号分隔，留空则不限制）
# 李奕兴：ou_d1d7f2c929754d891fee5d97bc894d74
EMAIL_AUTHORIZED_OPEN_IDS=ou_d1d7f2c929754d891fee5d97bc894d74

# ──────────────────────────────────────────────
# 其他配置（可选）
# ──────────────────────────────────────────────

# 本地仓库路径（默认自动推断，通常不需要修改）
# REPO_PATH=/path/to/kevinli.github.io
