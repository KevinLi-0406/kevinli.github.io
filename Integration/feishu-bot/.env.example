# ──────────────────────────────────────────────
# 飞书应用配置（必填）
# ──────────────────────────────────────────────

# 飞书应用 App ID（默认已填入）
FEISHU_APP_ID=cli_aa1d00640cf9dcd4

# 飞书应用 App Secret（必填！从飞书开放平台后台获取）
# 路径：开发者后台 → 应用 → 凭证与基础信息 → App Secret
FEISHU_APP_SECRET=your_app_secret_here

# ──────────────────────────────────────────────
# AI API 配置（必填）
# ──────────────────────────────────────────────

# AI API 地址（兼容 OpenAI API 格式）
# 示例：
#   OpenAI:        https://api.openai.com/v1/chat/completions
#   Azure OpenAI:  https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT/chat/completions?api-version=2024-02-15-preview
#   本地 Ollama:   http://localhost:11434/v1/chat/completions
#   其他兼容 API:  填写对应地址
AI_API_URL=https://api.openai.com/v1/chat/completions

# AI API Key（必填，除非使用无需认证的本地模型）
AI_API_KEY=your_api_key_here

# AI 模型名称
# 示例：gpt-4o-mini, gpt-4o, claude-3-5-sonnet, qwen-plus, deepseek-chat 等
AI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────
# 其他配置（可选）
# ──────────────────────────────────────────────

# 本地仓库路径（默认自动推断，通常不需要修改）
# REPO_PATH=/path/to/kevinli.github.io
